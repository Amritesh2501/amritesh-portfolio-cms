# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# The ONLY thing you change to move from local Docker Postgres to a hosted one
# (Neon / Supabase / RDS / Railway). No code changes required.
# Local docker-compose maps Postgres to host port 5433 to avoid clashing with
# an existing local Postgres on 5432.
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5433/portfolio?schema=public"

# ---------------------------------------------------------------------------
# AUTH  (Auth.js v5)
# ---------------------------------------------------------------------------
# Generate with:  openssl rand -base64 32
# or on Windows:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical origin. Required in production for correct cookie + callback URLs.
AUTH_URL="http://localhost:3000"

# Set to true only when running behind a reverse proxy (Vercel, Nginx, Fly).
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# SEED ADMIN USER
# ---------------------------------------------------------------------------
# Used by `npm run db:seed` to create the first admin account.
# CHANGE THE PASSWORD BEFORE SEEDING. The seed refuses to run in production
# with the default password.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_NAME="Amritesh Tiwari"

# ---------------------------------------------------------------------------
# STORAGE  (media uploads)
# ---------------------------------------------------------------------------
# "local" writes to ./public/uploads and serves from /uploads/... (dev default).
# "s3"    writes to any S3-compatible bucket (AWS S3, R2, MinIO, Spaces).
STORAGE_DRIVER="local"

# Only needed when STORAGE_DRIVER="s3".
S3_ENDPOINT=""                       # e.g. https://s3.ap-south-1.amazonaws.com or R2 endpoint
S3_REGION="ap-south-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""                # public CDN/base URL the bucket is served from
S3_FORCE_PATH_STYLE="false"          # "true" for MinIO / R2

# Max upload size in bytes (default 5 MB) and allowed mime types.
UPLOAD_MAX_BYTES="5242880"

# ---------------------------------------------------------------------------
# CONTACT FORM
# ---------------------------------------------------------------------------
# Requests allowed per window, per IP, on the contact endpoint.
CONTACT_RATE_LIMIT="5"
CONTACT_RATE_WINDOW_SECONDS="3600"

# ---------------------------------------------------------------------------
# PUBLIC
# ---------------------------------------------------------------------------
# Used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
